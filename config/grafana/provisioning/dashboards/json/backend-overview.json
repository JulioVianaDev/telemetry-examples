{
  "uid": "backend-overview",
  "title": "Backend Overview",
  "description": "Full observability: requests, latency, errors, traces & logs — filterable by tenant",
  "tags": ["backend", "nestjs", "otel", "multi-tenant"],
  "timezone": "browser",
  "editable": true,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "job",
        "type": "query",
        "datasource": { "uid": "prometheus" },
        "query": "label_values(traces_spanmetrics_calls_total{span_kind=\"SPAN_KIND_SERVER\"}, service)",
        "refresh": 2,
        "current": { "text": "backend-nestjs", "value": "backend-nestjs" },
        "includeAll": true,
        "multi": false
      },
      {
        "name": "tenant",
        "label": "Tenant",
        "type": "query",
        "datasource": { "uid": "prometheus" },
        "query": "label_values(traces_spanmetrics_calls_total{service=\"backend-nestjs\"}, tenant_id)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "current": { "text": "All", "value": "$__all" },
        "multi": false,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 20,
      "title": "Tenant Filter Info",
      "type": "text",
      "gridPos": { "h": 3, "w": 24, "x": 0, "y": 0 },
      "options": {
        "mode": "markdown",
        "content": "### Use the **Tenant** dropdown above to filter all panels by tenant.\nAll panels are filtered by the selected tenant via Tempo span metrics.\n\n**Tenants:** `tenant-acme` | `tenant-globex` | `tenant-initech` — **Users without tenant:** `user-6 (Frank)`, `user-7 (Grace)`"
      }
    },
    {
      "id": 1,
      "title": "Request Rate (req/s)",
      "description": "HTTP requests per second by route and method",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 3 },
      "datasource": { "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(traces_spanmetrics_calls_total{service=\"backend-nestjs\", span_kind=\"SPAN_KIND_SERVER\", tenant_id=~\"$tenant\"}[1m])) by (http_method, http_route)",
          "legendFormat": "{{http_method}} {{http_route}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 20,
            "pointSize": 5,
            "showPoints": "auto"
          },
          "color": { "mode": "palette-classic" }
        }
      }
    },
    {
      "id": 2,
      "title": "Request Latency (p50 / p95 / p99)",
      "description": "Response time percentiles in milliseconds",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 3 },
      "datasource": { "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(traces_spanmetrics_latency_bucket{service=\"backend-nestjs\", span_kind=\"SPAN_KIND_SERVER\", tenant_id=~\"$tenant\"}[5m])) by (le)) >= 0",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(traces_spanmetrics_latency_bucket{service=\"backend-nestjs\", span_kind=\"SPAN_KIND_SERVER\", tenant_id=~\"$tenant\"}[5m])) by (le)) >= 0",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(traces_spanmetrics_latency_bucket{service=\"backend-nestjs\", span_kind=\"SPAN_KIND_SERVER\", tenant_id=~\"$tenant\"}[5m])) by (le)) >= 0",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10
          },
          "color": { "mode": "palette-classic" }
        }
      }
    },
    {
      "id": 3,
      "title": "Error & Blocked Rate (%)",
      "description": "Percentage of 4xx and 5xx responses",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 3 },
      "datasource": { "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(traces_spanmetrics_calls_total{service=\"backend-nestjs\", span_kind=\"SPAN_KIND_SERVER\", http_status_code=~\"4..\", tenant_id=~\"$tenant\"}[5m])) / sum(rate(traces_spanmetrics_calls_total{service=\"backend-nestjs\", span_kind=\"SPAN_KIND_SERVER\", tenant_id=~\"$tenant\"}[5m])) * 100 or vector(0)",
          "legendFormat": "4xx %",
          "refId": "A"
        },
        {
          "expr": "sum(rate(traces_spanmetrics_calls_total{service=\"backend-nestjs\", span_kind=\"SPAN_KIND_SERVER\", http_status_code=~\"5..\", tenant_id=~\"$tenant\"}[5m])) / sum(rate(traces_spanmetrics_calls_total{service=\"backend-nestjs\", span_kind=\"SPAN_KIND_SERVER\", tenant_id=~\"$tenant\"}[5m])) * 100 or vector(0)",
          "legendFormat": "5xx %",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 30
          },
          "color": { "mode": "palette-classic" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "title": "Total Requests",
      "type": "stat",
      "gridPos": { "h": 4, "w": 5, "x": 0, "y": 11 },
      "datasource": { "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(traces_spanmetrics_calls_total{service=\"backend-nestjs\", span_kind=\"SPAN_KIND_SERVER\", tenant_id=~\"$tenant\"}[5m]))",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "area"
      }
    },
    {
      "id": 5,
      "title": "Avg Latency",
      "type": "stat",
      "gridPos": { "h": 4, "w": 5, "x": 5, "y": 11 },
      "datasource": { "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(traces_spanmetrics_latency_sum{service=\"backend-nestjs\", span_kind=\"SPAN_KIND_SERVER\", tenant_id=~\"$tenant\"}[$__rate_interval])) / sum(rate(traces_spanmetrics_latency_count{service=\"backend-nestjs\", span_kind=\"SPAN_KIND_SERVER\", tenant_id=~\"$tenant\"}[$__rate_interval]))",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 500 },
              { "color": "red", "value": 1000 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "area"
      }
    },
    {
      "id": 18,
      "title": "Blocked Requests (4xx)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 5, "x": 10, "y": 11 },
      "datasource": { "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(traces_spanmetrics_calls_total{service=\"backend-nestjs\", span_kind=\"SPAN_KIND_SERVER\", http_status_code=~\"4..\", tenant_id=~\"$tenant\"}) or vector(0)",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none"
      }
    },
    {
      "id": 6,
      "title": "Error Count (5xx)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 5, "x": 15, "y": 11 },
      "datasource": { "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(traces_spanmetrics_calls_total{service=\"backend-nestjs\", span_kind=\"SPAN_KIND_SERVER\", http_status_code=~\"5..\", tenant_id=~\"$tenant\"}) or vector(0)",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none"
      }
    },
    {
      "id": 7,
      "title": "Span Calls (from Tempo)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 11 },
      "datasource": { "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(traces_spanmetrics_calls_total{service=\"backend-nestjs\", span_kind=\"SPAN_KIND_SERVER\", tenant_id=~\"$tenant\"}[5m]))",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "blue", "value": null }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "area"
      }
    },
    {
      "id": 8,
      "title": "Requests by Status Code",
      "description": "Distribution of HTTP status codes over time",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "datasource": { "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(traces_spanmetrics_calls_total{service=\"backend-nestjs\", span_kind=\"SPAN_KIND_SERVER\", tenant_id=~\"$tenant\"}[1m])) by (http_status_code)",
          "legendFormat": "{{http_status_code}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 80,
            "stacking": { "mode": "normal" }
          },
          "color": { "mode": "palette-classic" }
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": "2.." },
            "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byRegexp", "options": "4.." },
            "properties": [{ "id": "color", "value": { "fixedColor": "yellow", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byRegexp", "options": "5.." },
            "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }]
          }
        ]
      }
    },
    {
      "id": 9,
      "title": "Latency by Route",
      "description": "Average response time per route",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
      "datasource": { "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(traces_spanmetrics_latency_sum{service=\"backend-nestjs\", span_kind=\"SPAN_KIND_SERVER\", tenant_id=~\"$tenant\"}[5m])) by (http_route) / sum(rate(traces_spanmetrics_latency_count{service=\"backend-nestjs\", span_kind=\"SPAN_KIND_SERVER\", tenant_id=~\"$tenant\"}[5m])) by (http_route)",
          "legendFormat": "{{http_route}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10
          },
          "color": { "mode": "palette-classic" }
        }
      }
    },
    {
      "id": 21,
      "title": "Tenant Activity",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 22,
      "title": "Span Rate by Tenant",
      "description": "Request rate per tenant from Tempo span metrics",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "datasource": { "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(traces_spanmetrics_calls_total{service=\"backend-nestjs\", span_kind=\"SPAN_KIND_SERVER\", tenant_id=~\"$tenant\"}[5m])) by (tenant_id)",
          "legendFormat": "{{tenant_id}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 25,
            "gradientMode": "scheme"
          },
          "color": { "mode": "palette-classic" }
        }
      }
    },
    {
      "id": 23,
      "title": "Span Latency by Tenant (p95)",
      "description": "p95 latency per tenant from Tempo span metrics",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "datasource": { "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(traces_spanmetrics_latency_bucket{service=\"backend-nestjs\", span_kind=\"SPAN_KIND_SERVER\", tenant_id=~\"$tenant\"}[5m])) by (le, tenant_id)) >= 0",
          "legendFormat": "p95 {{tenant_id}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10
          },
          "color": { "mode": "palette-classic" }
        }
      }
    },
    {
      "id": 24,
      "title": "Tenant Request Distribution",
      "description": "Pie chart of requests by tenant",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 32 },
      "datasource": { "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(traces_spanmetrics_calls_total{service=\"backend-nestjs\", span_kind=\"SPAN_KIND_SERVER\", tenant_id=~\".+\"}) by (tenant_id)",
          "legendFormat": "{{tenant_id}}",
          "refId": "A",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "legend": { "displayMode": "table", "placement": "right", "values": ["value", "percent"] },
        "pieType": "donut",
        "tooltip": { "mode": "single" }
      }
    },
    {
      "id": 25,
      "title": "Tenant Error Rate",
      "description": "Errors per tenant from span metrics (status_code=STATUS_CODE_ERROR)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 32 },
      "datasource": { "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(traces_spanmetrics_calls_total{service=\"backend-nestjs\", span_kind=\"SPAN_KIND_SERVER\", status_code=\"STATUS_CODE_ERROR\", tenant_id=~\"$tenant\"}[5m])) by (tenant_id)",
          "legendFormat": "errors {{tenant_id}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 60
          },
          "color": { "mode": "palette-classic" }
        }
      }
    },
    {
      "id": 26,
      "title": "Queue Processing by Tenant",
      "description": "Consumer span rate per tenant from Tempo span metrics",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 32 },
      "datasource": { "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(traces_spanmetrics_calls_total{service=\"consumer\", span_kind=\"SPAN_KIND_CONSUMER\", tenant_id=~\"$tenant\"}[5m])) by (tenant_id, span_name)",
          "legendFormat": "{{tenant_id}} — {{span_name}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 20
          },
          "color": { "mode": "palette-classic" }
        }
      }
    },
    {
      "id": 14,
      "title": "Trace Span Rate by Operation",
      "description": "Request rate derived from Tempo span metrics, filtered by tenant",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 40 },
      "datasource": { "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(traces_spanmetrics_calls_total{service=\"backend-nestjs\", span_kind=\"SPAN_KIND_SERVER\", tenant_id=~\"$tenant\"}[5m])) by (span_name)",
          "legendFormat": "{{span_name}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 20
          },
          "color": { "mode": "palette-classic" }
        }
      }
    },
    {
      "id": 15,
      "title": "Trace Span Latency (from Tempo)",
      "description": "p50/p95 latency from Tempo span metrics, filtered by tenant",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 40 },
      "datasource": { "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(traces_spanmetrics_latency_bucket{service=\"backend-nestjs\", span_kind=\"SPAN_KIND_SERVER\", tenant_id=~\"$tenant\"}[5m])) by (le, span_name)) >= 0",
          "legendFormat": "p50 {{span_name}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(traces_spanmetrics_latency_bucket{service=\"backend-nestjs\", span_kind=\"SPAN_KIND_SERVER\", tenant_id=~\"$tenant\"}[5m])) by (le, span_name)) >= 0",
          "legendFormat": "p95 {{span_name}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10
          },
          "color": { "mode": "palette-classic" }
        }
      }
    },
    {
      "id": 10,
      "title": "Recent Traces (filtered by tenant)",
      "description": "Search and explore traces — filtered by selected tenant",
      "type": "table",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 48 },
      "datasource": { "uid": "tempo" },
      "targets": [
        {
          "queryType": "traceql",
          "query": "{resource.service.name = \"backend-nestjs\" && span.span.source = \"http\" && span.http.route =~ \".+\" && span.tenant.id =~ \"$tenant\"}",
          "limit": 20,
          "tableType": "traces",
          "refId": "A"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          { "displayName": "Start time", "desc": true }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": { "type": "auto" },
            "inspect": false,
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "traceID" },
            "properties": [
              { "id": "custom.width", "value": 320 },
              {
                "id": "links",
                "value": [
                  {
                    "title": "View Trace ${__value.text}",
                    "url": "/explore?left=%7B%22datasource%22:%22tempo%22,%22queries%22:%5B%7B%22queryType%22:%22traceql%22,%22query%22:%22${__value.raw}%22%7D%5D%7D",
                    "targetBlank": true
                  }
                ]
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "traceDuration" },
            "properties": [
              { "id": "unit", "value": "ms" },
              { "id": "custom.width", "value": 140 },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "gradient"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "continuous-GrYlRd"
                }
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "rootTraceName" },
            "properties": [
              { "id": "custom.width", "value": 220 }
            ]
          }
        ]
      }
    },
    {
      "id": 11,
      "title": "Application Logs (filtered by tenant)",
      "description": "Logs from the backend service via Loki — filtered by selected tenant",
      "type": "logs",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 58 },
      "datasource": { "uid": "loki" },
      "targets": [
        {
          "expr": "{job=\"backend-nestjs\"} | json | attributes_span_source = `http` | attributes_tenant_id =~ `$tenant`",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      }
    },
    {
      "id": 12,
      "title": "Database Query Duration (from Tempo spans)",
      "description": "PostgreSQL query latency from pg-query span metrics",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 68 },
      "datasource": { "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(traces_spanmetrics_latency_bucket{service=\"pg-query\", span_kind=\"SPAN_KIND_CLIENT\"}[5m])) by (le)) >= 0",
          "legendFormat": "p95 DB latency",
