{
  "uid": "cron-dashboard",
  "title": "Cron Jobs Dashboard",
  "description": "Cron job observability: executions, success/failure, latency, stats consumer & logs — filterable by tenant and cron job",
  "tags": ["backend", "cron", "otel", "multi-tenant"],
  "timezone": "browser",
  "editable": true,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "cron_job",
        "label": "Cron Job",
        "type": "query",
        "datasource": { "uid": "prometheus" },
        "query": "label_values(traces_spanmetrics_calls_total{span_source=\"cron\", cron_job=~\".+\"}, cron_job)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "current": { "text": "All", "value": "$__all" },
        "multi": false,
        "sort": 1
      },
      {
        "name": "tenant",
        "label": "Tenant",
        "type": "query",
        "datasource": { "uid": "prometheus" },
        "query": "label_values(traces_spanmetrics_calls_total{span_source=\"cron\"}, tenant_id)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "current": { "text": "All", "value": "$__all" },
        "multi": false,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 2,
      "title": "Cron Info",
      "type": "text",
      "gridPos": { "h": 3, "w": 24, "x": 0, "y": 1 },
      "options": {
        "mode": "markdown",
        "content": "### Cron Jobs Monitoring\nUse the **Cron Job** dropdown to filter by specific cron job. All panels show **only cron-originated spans** (`span.source=cron`).\n\n**Jobs:** `message-stats-collection` (stats per tenant → queue → DB) | `ping-database` (PostgreSQL + RabbitMQ health check)\n\n**Schedule:** every 2 minutes (`*/2 * * * *`)"
      }
    },
    {
      "id": 10,
      "title": "Cron Executions",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 4 },
      "datasource": { "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(traces_spanmetrics_calls_total{service=\"backend-nestjs\", span_source=\"cron\", cron_job=~\"$cron_job\", span_name=~\"cron:.*\", span_kind=\"SPAN_KIND_INTERNAL\"}[5m])) by (cron_job) or vector(0)",
          "legendFormat": "{{cron_job}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "blue", "value": null }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "area"
      }
    },
    {
      "id": 11,
      "title": "Cron Success Rate",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 4 },
      "datasource": { "uid": "prometheus" },
      "targets": [
        {
          "expr": "(\n  sum(rate(traces_spanmetrics_calls_total{service=\"backend-nestjs\", span_source=\"cron\", cron_job=~\"$cron_job\", span_name=~\"cron:(message-stats-collection|ping-database)\", status_code=\"STATUS_CODE_OK\"}[5m]))\n  /\n  clamp_min(sum(rate(traces_spanmetrics_calls_total{service=\"backend-nestjs\", span_source=\"cron\", cron_job=~\"$cron_job\", span_name=~\"cron:(message-stats-collection|ping-database)\"}[5m])), 1)\n) * 100 or vector(100)",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 90 },
              { "color": "green", "value": 99 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none"
      }
    },
    {
      "id": 12,
      "title": "Cron Failures",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 4 },
      "datasource": { "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(traces_spanmetrics_calls_total{service=\"backend-nestjs\", span_source=\"cron\", cron_job=~\"$cron_job\", span_name=~\"cron:(message-stats-collection|ping-database)\", status_code=\"STATUS_CODE_ERROR\"}) or vector(0)",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none"
      }
    },
    {
      "id": 13,
      "title": "Stats Consumer Rate",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 4 },
      "datasource": { "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(traces_spanmetrics_calls_total{service=\"stats-consumer\", span_name=\"stats:process\"}[5m])) or vector(0)",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "purple", "value": null }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "area"
      }
    },
    {
      "id": 20,
      "title": "Cron Execution Rate by Job (success vs error)",
      "description": "Cron job execution rate split by job and status",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(traces_spanmetrics_calls_total{service=\"backend-nestjs\", span_source=\"cron\", cron_job=~\"$cron_job\", span_name=~\"cron:(message-stats-collection|ping-database)\", status_code=\"STATUS_CODE_OK\"}[1m])) by (cron_job) or vector(0)",
          "legendFormat": "{{cron_job}} success",
          "refId": "A"
        },
        {
          "expr": "sum(rate(traces_spanmetrics_calls_total{service=\"backend-nestjs\", span_source=\"cron\", cron_job=~\"$cron_job\", span_name=~\"cron:(message-stats-collection|ping-database)\", status_code=\"STATUS_CODE_ERROR\"}[1m])) by (cron_job) or vector(0)",
          "legendFormat": "{{cron_job}} error",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 80,
            "stacking": { "mode": "normal" }
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": ".*success$" },
            "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byRegexp", "options": ".*error$" },
            "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }]
          }
        ]
      }
    },
    {
      "id": 21,
      "title": "Cron Execution Latency by Job",
      "description": "How long each cron job takes (p50/p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(traces_spanmetrics_latency_bucket{service=\"backend-nestjs\", span_source=\"cron\", cron_job=~\"$cron_job\", span_name=~\"cron:(message-stats-collection|ping-database)\"}[5m])) by (le, cron_job)) >= 0",
          "legendFormat": "p50 {{cron_job}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(traces_spanmetrics_latency_bucket{service=\"backend-nestjs\", span_source=\"cron\", cron_job=~\"$cron_job\", span_name=~\"cron:(message-stats-collection|ping-database)\"}[5m])) by (le, cron_job)) >= 0",
          "legendFormat": "p95 {{cron_job}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15
          },
          "color": { "mode": "palette-classic" }
        }
      }
    },
    {
      "id": 30,
      "title": "Per-Tenant Cron Activity",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 16 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 31,
      "title": "Cron Span Rate by Tenant",
      "description": "Cron span rate per tenant",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 17 },
      "datasource": { "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(traces_spanmetrics_calls_total{service=\"backend-nestjs\", span_source=\"cron\", cron_job=~\"$cron_job\", tenant_id=~\"$tenant\"}[5m])) by (tenant_id)",
          "legendFormat": "{{tenant_id}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 25,
            "gradientMode": "scheme"
          },
          "color": { "mode": "palette-classic" }
        }
      }
    },
    {
      "id": 32,
      "title": "Cron Latency by Tenant (p95)",
      "description": "p95 latency of cron per-tenant processing",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 17 },
      "datasource": { "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(traces_spanmetrics_latency_bucket{service=\"backend-nestjs\", span_source=\"cron\", cron_job=~\"$cron_job\", tenant_id=~\"$tenant\"}[5m])) by (le, tenant_id)) >= 0",
          "legendFormat": "p95 {{tenant_id}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10
          },
          "color": { "mode": "palette-classic" }
        }
      }
    },
    {
      "id": 33,
      "title": "Tenant Error Rate (cron)",
      "description": "Errors per tenant from cron spans",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 25 },
      "datasource": { "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(traces_spanmetrics_calls_total{service=\"backend-nestjs\", span_source=\"cron\", cron_job=~\"$cron_job\", status_code=\"STATUS_CODE_ERROR\", tenant_id=~\"$tenant\"}[5m])) by (tenant_id, span_name)",
          "legendFormat": "{{tenant_id}} — {{span_name}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 60
          },
          "color": { "mode": "palette-classic" }
        }
      }
    },
    {
      "id": 34,
      "title": "Stats Consumer Processing by Tenant",
      "description": "Stats consumer span rate per tenant",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 25 },
      "datasource": { "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(traces_spanmetrics_calls_total{service=\"stats-consumer\", span_name=~\"stats:.*\", tenant_id=~\"$tenant\"}[5m])) by (tenant_id, span_name)",
          "legendFormat": "{{tenant_id}} — {{span_name}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 20
          },
          "color": { "mode": "palette-classic" }
        }
      }
    },
    {
      "id": 40,
      "title": "Cron Traces & Logs",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 33 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 41,
      "title": "Cron Span Rate by Operation",
      "description": "All cron span operations over time",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 34 },
      "datasource": { "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(traces_spanmetrics_calls_total{service=\"backend-nestjs\", span_source=\"cron\", cron_job=~\"$cron_job\", tenant_id=~\"$tenant\"}[5m])) by (span_name)",
          "legendFormat": "{{span_name}}",
          "refId": "A"
        },
        {
          "expr": "sum(rate(traces_spanmetrics_calls_total{service=\"stats-consumer\", tenant_id=~\"$tenant\"}[5m])) by (span_name)",
          "legendFormat": "{{span_name}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 20
          },
          "color": { "mode": "palette-classic" }
        }
      }
    },
    {
      "id": 42,
      "title": "Recent Cron Traces",
      "description": "Cron job traces from Tempo — click a Trace ID to inspect the full trace waterfall",
      "type": "table",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 42 },
      "datasource": { "uid": "tempo" },
      "targets": [
        {
          "queryType": "traceql",
          "query": "{resource.service.name = \"backend-nestjs\" && span.span.source = \"cron\" && span.cron.job =~ \"$cron_job\"}",
          "limit": 20,
          "tableType": "traces",
          "refId": "A"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          { "displayName": "Start time", "desc": true }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": { "type": "auto" },
            "inspect": false,
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "traceID" },
            "properties": [
              { "id": "custom.width", "value": 320 },
              {
                "id": "links",
                "value": [
                  {
                    "title": "View Trace ${__value.text}",
                    "url": "/explore?left=%7B%22datasource%22:%22tempo%22,%22queries%22:%5B%7B%22queryType%22:%22traceql%22,%22query%22:%22${__value.raw}%22%7D%5D%7D",
                    "targetBlank": true
                  }
                ]
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "traceDuration" },
            "properties": [
              { "id": "unit", "value": "ms" },
              { "id": "custom.width", "value": 140 },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "gradient"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "continuous-GrYlRd"
                }
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "rootTraceName" },
            "properties": [
              { "id": "custom.width", "value": 280 }
            ]
          }
        ]
      }
    },
    {
      "id": 43,
      "title": "Cron Logs",
      "description": "All cron and stats consumer logs from Loki — filtered by cron job and tenant",
      "type": "logs",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 52 },
      "datasource": { "uid": "loki" },
      "targets": [
        {
          "expr": "{job=\"backend-nestjs\"} | json | attributes_span_source = `cron` | attributes_cron_job =~ `$cron_job` | attributes_tenant_id =~ `$tenant`",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      }
    },
    {
      "id": 44,
      "title": "Cron Error Logs",
      "description": "Only error/warn logs from cron jobs",
      "type": "logs",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 64 },
      "datasource": { "uid": "loki" },
      "targets": [
        {
          "expr": "{job=\"backend-nestjs\"} | json | attributes_span_source = `cron` | level =~ `error|warn` | attributes_cron_job =~ `$cron_job` | attributes_tenant_id =~ `$tenant`",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      }
    }
  ],
  "schemaVersion": 39
}
