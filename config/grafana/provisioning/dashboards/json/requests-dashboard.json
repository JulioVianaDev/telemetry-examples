{
  "uid": "requests-dashboard",
  "title": "Requests Dashboard",
  "description": "Detailed endpoint analysis with drill-down to individual traces",
  "tags": ["backend", "requests", "traces"],
  "timezone": "browser",
  "editable": true,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "method",
        "label": "Method",
        "type": "query",
        "datasource": { "uid": "prometheus" },
        "query": "label_values(http_server_duration_milliseconds_count{job=\"backend-nestjs\", http_route=~\".+\"}, http_method)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "current": { "text": "All", "value": "$__all" },
        "multi": false,
        "sort": 1
      },
      {
        "name": "endpoint",
        "label": "Endpoint",
        "type": "query",
        "datasource": { "uid": "prometheus" },
        "query": "label_values(http_server_duration_milliseconds_count{job=\"backend-nestjs\", http_route=~\".+\", http_method=~\"$method\"}, http_route)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".+",
        "current": { "text": "All", "value": "$__all" },
        "multi": false,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 100,
      "title": "",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 1,
      "title": "Endpoints Overview (click an endpoint to drill down)",
      "description": "Summary of all HTTP endpoints. Click an endpoint name to filter all panels below.",
      "type": "table",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 1 },
      "datasource": { "uid": "prometheus" },
      "targets": [
        {
          "expr": "label_join(sum(http_server_duration_milliseconds_count{job=\"backend-nestjs\", http_route=~\"$endpoint\", http_method=~\"$method\"}) by (http_method, http_route), \"span_name\", \" \", \"http_method\", \"http_route\")",
          "legendFormat": "",
          "refId": "total_requests",
          "instant": true,
          "format": "table"
        },
        {
          "expr": "label_join(sum(http_server_duration_milliseconds_sum{job=\"backend-nestjs\", http_route=~\"$endpoint\", http_method=~\"$method\"}) by (http_method, http_route) / clamp_min(sum(http_server_duration_milliseconds_count{job=\"backend-nestjs\", http_route=~\"$endpoint\", http_method=~\"$method\"}) by (http_method, http_route), 1), \"span_name\", \" \", \"http_method\", \"http_route\")",
          "legendFormat": "",
          "refId": "avg_latency",
          "instant": true,
          "format": "table"
        },
        {
          "expr": "label_join(histogram_quantile(0.95, sum(http_server_duration_milliseconds_bucket{job=\"backend-nestjs\", http_route=~\"$endpoint\", http_method=~\"$method\"}) by (le, http_method, http_route)) >= 0, \"span_name\", \" \", \"http_method\", \"http_route\")",
          "legendFormat": "",
          "refId": "p95_latency",
          "instant": true,
          "format": "table"
        },
        {
          "expr": "label_join(histogram_quantile(0.99, sum(http_server_duration_milliseconds_bucket{job=\"backend-nestjs\", http_route=~\"$endpoint\", http_method=~\"$method\"}) by (le, http_method, http_route)) >= 0, \"span_name\", \" \", \"http_method\", \"http_route\")",
          "legendFormat": "",
          "refId": "p99_latency",
          "instant": true,
          "format": "table"
        },
        {
          "expr": "label_join(sum(rate(http_server_duration_milliseconds_count{job=\"backend-nestjs\", http_route=~\"$endpoint\", http_method=~\"$method\"}[5m])) by (http_method, http_route), \"span_name\", \" \", \"http_method\", \"http_route\")",
          "legendFormat": "",
          "refId": "req_rate",
          "instant": true,
          "format": "table"
        },
        {
          "expr": "label_join(sum(http_server_duration_milliseconds_count{job=\"backend-nestjs\", http_route=~\"$endpoint\", http_method=~\"$method\", http_status_code=~\"2..\"}) by (http_method, http_route), \"span_name\", \" \", \"http_method\", \"http_route\")",
          "legendFormat": "",
          "refId": "count_2xx",
          "instant": true,
          "format": "table"
        },
        {
          "expr": "label_join(sum(http_server_duration_milliseconds_count{job=\"backend-nestjs\", http_route=~\"$endpoint\", http_method=~\"$method\", http_status_code=~\"4..\"}) by (http_method, http_route), \"span_name\", \" \", \"http_method\", \"http_route\")",
          "legendFormat": "",
          "refId": "count_4xx",
          "instant": true,
          "format": "table"
        },
        {
          "expr": "label_join(sum(http_server_duration_milliseconds_count{job=\"backend-nestjs\", http_route=~\"$endpoint\", http_method=~\"$method\", http_status_code=~\"5..\"}) by (http_method, http_route), \"span_name\", \" \", \"http_method\", \"http_route\")",
          "legendFormat": "",
          "refId": "count_5xx",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "Time 4": true,
              "Time 5": true,
              "Time 6": true,
              "Time 7": true,
              "Time 8": true
            },
            "renameByName": {
              "span_name": "Endpoint",
              "Value #total_requests": "Total Requests",
              "Value #avg_latency": "Avg Latency (ms)",
              "Value #p95_latency": "p95 Latency (ms)",
              "Value #p99_latency": "p99 Latency (ms)",
              "Value #req_rate": "Rate (req/s)",
              "Value #count_2xx": "2xx Count",
              "Value #count_4xx": "4xx Count",
              "Value #count_5xx": "5xx Count"
            },
            "indexByName": {
              "span_name": 0,
              "Value #req_rate": 1,
              "Value #total_requests": 2,
              "Value #avg_latency": 3,
              "Value #p95_latency": 4,
              "Value #p99_latency": 5,
              "Value #count_2xx": 6,
              "Value #count_4xx": 7,
              "Value #count_5xx": 8,
              "http_method": 9,
              "http_route": 10
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "custom": {
            "align": "center",
            "cellOptions": { "type": "auto" },
            "inspect": false,
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "http_route" },
            "properties": [
              { "id": "custom.hidden", "value": true }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "http_method" },
            "properties": [
              { "id": "custom.hidden", "value": true }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Endpoint" },
            "properties": [
              { "id": "custom.align", "value": "left" },
              { "id": "custom.width", "value": 220 },
              { "id": "noValue", "value": "-" },
              {
                "id": "links",
                "value": [
                  {
                    "title": "Drill down into ${__value.text}",
                    "url": "/d/requests-dashboard/requests-dashboard?var-method=${__data.fields.http_method}&var-endpoint=${__data.fields.http_route}&${__url_time_range}",
                    "targetBlank": false
                  }
                ]
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Total Requests" },
            "properties": [
              { "id": "unit", "value": "short" },
              { "id": "decimals", "value": 0 },
              { "id": "custom.width", "value": 130 },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "gradient"
                }
              },
              {
                "id": "color",
                "value": { "mode": "continuous-blues" }
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Rate (req/s)" },
            "properties": [
              { "id": "unit", "value": "reqps" },
              { "id": "decimals", "value": 3 },
              { "id": "custom.width", "value": 120 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Avg Latency (ms)" },
            "properties": [
              { "id": "unit", "value": "ms" },
              { "id": "decimals", "value": 2 },
              { "id": "custom.width", "value": 140 },
              { "id": "noValue", "value": "-" },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "gradient"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green", "value": null },
                    { "color": "yellow", "value": 100 },
                    { "color": "red", "value": 500 }
                  ]
                }
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "p95 Latency (ms)" },
            "properties": [
              { "id": "unit", "value": "ms" },
              { "id": "decimals", "value": 2 },
              { "id": "custom.width", "value": 140 },
              { "id": "noValue", "value": "-" },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "gradient"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green", "value": null },
                    { "color": "yellow", "value": 200 },
                    { "color": "red", "value": 1000 }
                  ]
                }
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "p99 Latency (ms)" },
            "properties": [
              { "id": "unit", "value": "ms" },
              { "id": "decimals", "value": 2 },
              { "id": "custom.width", "value": 140 },
              { "id": "noValue", "value": "-" }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "2xx Count" },
            "properties": [
              { "id": "decimals", "value": 0 },
              { "id": "custom.width", "value": 100 },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "color",
                "value": { "fixedColor": "green", "mode": "fixed" }
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "4xx Count" },
            "properties": [
              { "id": "decimals", "value": 0 },
              { "id": "custom.width", "value": 100 },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "transparent", "value": null },
                    { "color": "yellow", "value": 1 }
                  ]
                }
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "5xx Count" },
            "properties": [
              { "id": "decimals", "value": 0 },
              { "id": "custom.width", "value": 100 },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "transparent", "value": null },
                    { "color": "red", "value": 1 }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": true,
          "reducer": ["sum"],
          "countRows": false,
          "fields": ["Value #total_requests", "Value #count_2xx", "Value #count_4xx", "Value #count_5xx"]
        },
        "sortBy": [
          { "displayName": "Total Requests", "desc": true }
        ]
      }
    },
    {
      "id": 101,
      "title": "$method $endpoint",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 11 },
      "collapsed": false,
      "repeat": null,
      "panels": []
    },
    {
      "id": 2,
      "title": "Request Rate — $method $endpoint",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 12 },
      "datasource": { "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(http_server_duration_milliseconds_count{job=\"backend-nestjs\", http_route=~\"$endpoint\", http_method=~\"$method\"}[1m])) by (http_method, http_route)",
          "legendFormat": "{{http_method}} {{http_route}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 25,
            "gradientMode": "scheme"
          },
          "color": { "mode": "palette-classic" }
        }
      }
    },
    {
      "id": 3,
      "title": "Latency Over Time — $method $endpoint",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 12 },
      "datasource": { "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(http_server_duration_milliseconds_bucket{job=\"backend-nestjs\", http_route=~\"$endpoint\", http_method=~\"$method\"}[5m])) by (le)) >= 0",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_duration_milliseconds_bucket{job=\"backend-nestjs\", http_route=~\"$endpoint\", http_method=~\"$method\"}[5m])) by (le)) >= 0",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_server_duration_milliseconds_bucket{job=\"backend-nestjs\", http_route=~\"$endpoint\", http_method=~\"$method\"}[5m])) by (le)) >= 0",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10
          },
          "color": { "mode": "palette-classic" }
        }
      }
    },
    {
      "id": 4,
      "title": "Status Codes — $method $endpoint",
      "type": "piechart",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 12 },
      "datasource": { "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(http_server_duration_milliseconds_count{job=\"backend-nestjs\", http_route=~\"$endpoint\", http_method=~\"$method\"}) by (http_status_code)",
          "legendFormat": "{{http_status_code}}",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": "^2" },
            "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byRegexp", "options": "^4" },
            "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byRegexp", "options": "^5" },
            "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }]
          }
        ]
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "legend": { "displayMode": "table", "placement": "right", "values": ["value", "percent"] },
        "pieType": "donut",
        "tooltip": { "mode": "single" }
      }
    },
    {
      "id": 102,
      "title": "Individual Requests — $method $endpoint",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 19 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 5,
      "title": "Traces — $method $endpoint  |  Click a Trace ID to inspect",
      "description": "Individual traced requests. Click any Trace ID to open the full trace waterfall.",
      "type": "table",
      "gridPos": { "h": 14, "w": 24, "x": 0, "y": 20 },
      "datasource": { "uid": "tempo" },
      "targets": [
        {
          "queryType": "traceql",
          "query": "{resource.service.name = \"backend-nestjs\" && span.http.route =~ \"^$endpoint$$\" && span.http.method =~ \"^$method$$\"}",
          "limit": 50,
          "tableType": "traces",
          "refId": "A"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          { "displayName": "Start time", "desc": true }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": { "type": "auto" },
            "inspect": false,
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "traceID" },
            "properties": [
              { "id": "custom.width", "value": 320 },
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open Trace ${__value.text}",
                    "url": "/explore?left={\"datasource\":\"tempo\",\"queries\":[{\"queryType\":\"traceql\",\"query\":\"${__value.raw}\"}]}",
                    "targetBlank": true
                  }
                ]
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "traceDuration" },
            "properties": [
              { "id": "unit", "value": "ms" },
              { "id": "custom.width", "value": 140 },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "gradient"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "continuous-GrYlRd"
                }
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "startTime" },
            "properties": [
              { "id": "custom.width", "value": 200 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "rootServiceName" },
            "properties": [
              { "id": "custom.width", "value": 180 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "rootTraceName" },
            "properties": [
              { "id": "custom.width", "value": 200 }
            ]
          }
        ]
      }
    },
    {
      "id": 103,
      "title": "Logs",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 34 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 6,
      "title": "Application Logs — $method $endpoint",
      "description": "All service logs. Each log carries a traceId — match it with a Trace ID from the table above to correlate logs with filtered requests.",
      "type": "logs",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 35 },
      "datasource": { "uid": "loki" },
      "targets": [
        {
          "expr": "{job=\"backend-nestjs\"} | json",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      }
    }
  ],
  "schemaVersion": 39
}
